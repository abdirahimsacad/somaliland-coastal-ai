import streamlit as st
import folium
from streamlit_folium import st_folium
import requests
from twilio.rest import Client
import pandas as pd

# --- QAABAYNTA (CONFIGURATION) ---
OPENWEATHER_API_KEY = "GELI_OPENWEATHER_KEY_HAPA" # <-- Geli API Key-gaaga
TWILIO_SID = "GELI_TWILIO_SID"
TWILIO_TOKEN = "GELI_TWILIO_TOKEN"
TWILIO_PHONE = "GELI_TWILIO_NUMBER"
KALLUMAYSATA_PHONES = ["+252xxxxxxxxx"] # Lambarada qaadanaya digniinta

# 1. Liiska Magaalooyinka Xeebta Somaliland
COASTAL_CITIES = {
    "Berbera": {"lat": 10.4396, "lon": 45.0119},
    "Saylac": {"lat": 11.3533, "lon": 43.4683},
    "Maydh": {"lat": 11.0000, "lon": 47.1167},
    "Lughaya": {"lat": 10.6833, "lon": 43.9333}
}

# 2. Agent-ka Xogta (Weather Agent)
def get_real_weather(city_name):
    url = f"http://api.openweathermap.org/data/2.5/weather?q={city_name}&appid={OPENWEATHER_API_KEY}&units=metric"
    try:
        response = requests.get(url).json()
        data = {
            "temp": response['main']['temp'],
            "wind_speed": response['wind']['speed'], # m/s
            "humidity": response['main']['humidity'],
            "desc": response['weather'][0]['description']
        }
        return data
    except:
        return None

# 3. Agent-ka SMS-ka (Notification Agent)
def send_alert_sms(city, message):
    try:
        client = Client(TWILIO_SID, TWILIO_TOKEN)
        for phone in KALLUMAYSATA_PHONES:
            client.messages.create(
                body=f"DIGNIIN XEEBTA {city.upper()}: {message}",
                from_=TWILIO_PHONE,
                to=phone
            )
        return True
    except:
        return False

# --- DASHBOARD UI (STREAMLIT) ---
st.set_page_config(page_title="Agentic AI Somaliland Coast", layout="wide")
st.title("🌊 Agentic AI: Nidaamka Ilaalinta Xeebaha Somaliland")
st.markdown("Nidaamkan wuxuu si toos ah u falanqeeyaa cimilada wuxuuna diraa digniino SMS ah.")

# Ururi xogta dhabta ah ee magaalo kasta
all_data = []
for city, coords in COASTAL_CITIES.items():
    weather = get_real_weather(city)
    if weather:
        # AI Logic: Go'aan ka gaadhista khatarta
        risk = "CAGAAR"
        status_color = "green"
        if weather['wind_speed'] > 12: # Xawaare sare
            risk = "CASAAN"
            status_color = "red"
        elif weather['wind_speed'] > 7:
            risk = "JAALLO"
            status_color = "orange"
        
        all_data.append({
            "City": city,
            "Lat": coords['lat'],
            "Lon": coords['lon'],
            "Wind": weather['wind_speed'],
            "Temp": weather['temp'],
            "Risk": risk,
            "Color": status_color
        })

# --- QAYBTA KHARIIDADDA ---
col1, col2 = st.columns([2, 1])

with col1:
    st.subheader("📍 Khariidadda Khatarta Xeebaha")
    m = folium.Map(location=[10.8, 45.0], zoom_start=7, tiles="OpenStreetMap")
    
    for d in all_data:
        folium.Marker(
            location=[d['Lat'], d['Lon']],
            popup=f"{d['City']}: Dabaysha {d['Wind']} m/s",
            icon=folium.Icon(color=d['Color'], icon="cloud")
        ).add_to(m)
    
    st_folium(m, width=800, height=500)

with col2:
    st.subheader("📊 Xaaladda Hadda")
    for d in all_data:
        st.metric(label=f"Xeebta {d['City']}", value=f"{d['Wind']} m/s", delta=d['Risk'])
        if d['Risk'] == "CASAAN":
            if st.button(f"Dir SMS: {d['City']}"):
                msg = f"Khatar! Dabayshu waa {d['Wind']} m/s. Fadlan dibadda ha u bixin."
                success = send_alert_sms(d['City'], msg)
                if success: st.success(f"SMS loo diray {d['City']}")
                else: st.error("Twilio ma shaqayn (Check API Keys)")

# --- QAYBTA ANALYTICS ---
st.divider()
st.subheader("📈 Xogta Guud")
df = pd.DataFrame(all_data)
st.table(df[['City', 'Wind', 'Temp', 'Risk']])

st.info("Nidaamkani wuxuu si otomaatig ah u cusboonaysiiyaa xogta 10-kii daqiiqaba.")
